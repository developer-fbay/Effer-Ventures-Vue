# Copy to .env for local development. On Cloudflare Pages, add these as encrypted
# environment variables instead. Never commit real values.

# n8n webhook that receives the contact form (Production URL from the Webhook node)
NUXT_CONTACT_WEBHOOK_URL=

# n8n Header Auth on the webhook (header name and value). n8n refuses the message without them.
NUXT_CONTACT_WEBHOOK_AUTH_HEADER=X-Webhook-Secret
NUXT_CONTACT_WEBHOOK_AUTH_VALUE=
